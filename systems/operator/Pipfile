[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pydantic = ">=2.0.0"
dataclasses-json = ">=0.6.0"
python-dateutil = ">=2.8.2"
pyyaml = ">=6.0.1"
aiokafka = ">=0.10.0"
paho-mqtt = ">=1.6.1"
structlog = ">=23.1.0"
prometheus-client = ">=0.18.0"
python-dotenv = ">=1.0.0"
click = ">=8.1.0"

[dev-packages]
pytest = ">=7.4.0"
pytest-asyncio = ">=0.21.0"
pytest-cov = ">=4.1.0"
pytest-mock = ">=3.11.0"
black = ">=23.7.0"
flake8 = ">=6.1.0"
mypy = ">=1.5.0"
bandit = ">=1.7.5"
radon = ">=6.0.1"
sphinx = ">=7.1.0"
sphinx-rtd-theme = ">=1.3.0"
jupyter = ">=1.0.0"
notebook = ">=7.0.0"
ipykernel = ">=6.25.0"
plantuml = ">=0.3.0"

[requires]

[scripts]
test = "pytest"
test-unit = "pytest tests/unit"
test-module = "pytest tests/module"
test-integration = "pytest tests/integration"
format = "black ."
lint = "flake8 ."
typecheck = "mypy ."
security = "bandit -r src/"
complexity = "radon cc src/ -a -nb"
docs = "sphinx-build -b html docs/ docs/_build"
notebook = "jupyter notebook"