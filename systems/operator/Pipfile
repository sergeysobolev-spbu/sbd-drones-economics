[[source]]
url = "https://pypi.org/simple"
verify_ssl = true
name = "pypi"

[packages]
pyyaml = ">=6.0"
pydantic = ">=2.0"
asyncio-mqtt = ">=0.16.0"
aiohttp = ">=3.8.0"
python-dotenv = ">=1.0.0"
flask = ">=3.1.3"

[dev-packages]
pytest = ">=7.0.0"
pytest-asyncio = ">=0.21.0"
pytest-cov = ">=4.0.0"
pytest-xdist = ">=3.0.0"
black = ">=23.0.0"
flake8 = ">=6.0.0"
mypy = ">=1.0.0"
jupyter = ">=1.0.0"
nbconvert = ">=7.0.0"
plantuml = ">=0.3.0"
kafka-python = ">=2.0.2"
paho-mqtt = ">=1.6.1"

[requires]
python_version = "3.12.3"

[scripts]
test = "pytest"
test-unit = "pytest src/*/tests/unit -v"
test-module = "pytest src/*/tests/module -v"
test-integration = "pytest src/*/tests/integration -v"
format = "black ."
lint = "flake8"
typecheck = "mypy ."
notebook = "jupyter notebook"