@startuml fleet_manager_architecture
!theme plain
title Fleet Manager Component Architecture

' Определение стилей
skinparam component {
    BackgroundColor<<trusted>> LightGreen
    BorderColor<<trusted>> DarkGreen
    BackgroundColor<<operational>> LightBlue
    BorderColor<<operational>> DarkBlue
    BackgroundColor<<external>> LightGray
    BorderColor<<external>> DarkGray
}

skinparam package {
    BackgroundColor<<domain>> Wheat
    BorderColor<<domain>> Brown
}

' Домены безопасности
package "D1_TRUSTED Domain" <<domain>> {
    component "FleetManagerCore" <<trusted>> {
        note right
            Минимальный код (~250 строк)
            - authorize_uas_operation()
            - reserve_uas()
            - release_uas()
            - update_uas_state()
            - add_uas()
            - get_uas_state()
        end note
    }
    
    database "Critical State" <<trusted>> {
        note bottom
            - UAS ID
            - Status
            - Certificate Valid
            - Certificate Expiry
            - Battery Level
            - Reserved By
        end note
    }
}

package "D2_OPERATIONAL Domain" <<domain>> {
    component "FleetManagerService" <<operational>> {
        note right
            Бизнес-логика (~800 строк)
            - find_suitable_uas()
            - calculate_suitability_score()
            - initialize_fleet()
            - get_fleet_statistics()
            - get_purchase_history()
        end note
    }
    
    database "Extended State" <<operational>> {
        note bottom
            - UAS Type
            - Location
            - Max Payload
            - Max Range
            - Flight Hours
            - Maintenance Info
        end note
    }
    
    component "Metrics & Logging" <<operational>>
}

' Внешние компоненты
component "FleetManager\n(Main Component)" as FM

component "System Bus\n(MQTT/Kafka)" <<external>>
component "Regulator Client" <<external>>
component "Developer Client" <<external>>

' Связи
FM --> FleetManagerCore : uses
FM --> FleetManagerService : uses
FleetManagerCore --> "Critical State" : manages
FleetManagerService --> "Extended State" : manages
FleetManagerService --> FleetManagerCore : calls critical\nfunctions
FleetManagerService --> "Metrics & Logging" : logs

FM <--> "System Bus\n(MQTT/Kafka)" : messages
FleetManagerService --> "Regulator Client" : get topics\ncheck certificates
FleetManagerService --> "Developer Client" : get catalogs\npurchase UAS

' Аннотации безопасности
note top of FleetManagerCore
    **Security Goals:**
    - SG-FM-001: Access Control
    - SG-FM-002: State Integrity
    - SG-FM-003: Certificate Control
end note

note top of FleetManagerService
    **Security Goals:**
    - SG-FM-004: Audit
    - SG-FM-005: Availability
end note

@enduml