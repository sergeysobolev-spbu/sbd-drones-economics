@startuml integration_firmware_certification
title Сертификация прошивки

skinparam ArrowThickness 2

autonumber
actor "Разработчик" as Dev
participant "api_gateway" as GW #FFCDD2
participant "firmware_ingestion" as FW #FFF9C4
participant "certification_service" as CERT #FFF9C4
database "SQLite" as UASDB #C8E6C9
participant "Регулятор\nAPI/consumer" as REG #E8F5E9
database "Реестр Регулятора" as REGDB #C8E6C9

Dev -> GW : POST /api/firmware\n[INT-FR-2]
GW -> FW : submit_firmware\n[INT-NFR-2]
FW -> UASDB : save firmware metadata\n(высокоцелостная запись)
Dev -> GW : POST /api/certify
GW -> CERT : certify_firmware
CERT -> REG : certify_firmware\n[INT-FR-1, INT-NFR-1]
REG -> REGDB : certificate state
REG -> CERT : certified | rejected\n[INT-FR-4]
CERT -> UASDB : projection / audit\n[INT-NFR-5]
GW -> Dev : certificate_id/status/reason
@enduml
