# Профиль портов E2E для локального запуска (make e2e, хост).
# Подключается через E2E_RUN_MODE=local (значение по умолчанию).

E2E_RUN_MODE=local

# Broker (хост)
KAFKA_PORT=9092
KAFKA_INTERNAL_PORT=29092
KAFKA_ADVERTISED_HOST=localhost
MQTT_PORT=1883

# HTTP-сервисы на хосте (E2E health-check и pytest)
AGREGATOR_PORT=8081
REGULATOR_PORT=8088
ANALYTICS_PORT=8090
DELIVERY_DRONE_HEALTH_PORT=8095
AGRODRON_GATEWAY_HOST_PORT=18081
SYSTEM_MONITOR_HOST_PORT=18090

# URL для pytest / health-check с хоста
AGREGATOR_URL=http://localhost:8081
REGULATOR_URL=http://localhost:8088
ANALYTICS_URL=http://localhost:8090
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
