# Профиль портов E2E для Jenkins-in-Docker (не пересекается с local).
# Подключается через E2E_RUN_MODE=jenkins (ci/Jenkinsfile.e2e).

E2E_RUN_MODE=jenkins

# Broker — хостовые порты в диапазоне 10000+ (не пересекаются с local: 9092/29092/1883)
BROKER_HOST=host.docker.internal
KAFKA_PORT=19092
KAFKA_INTERNAL_PORT=39092
KAFKA_ADVERTISED_HOST=host.docker.internal
MQTT_PORT=31883
MQTT_BROKER=host.docker.internal

# HTTP-сервисы на хосте (compose публикует на эти порты)
AGREGATOR_PORT=10801
REGULATOR_PORT=10808
ANALYTICS_PORT=10990
DELIVERY_DRONE_HEALTH_PORT=10995
AGRODRON_GATEWAY_HOST_PORT=11881
SYSTEM_MONITOR_HOST_PORT=11890

# URL для pytest / health-check из контейнера Jenkins
AGREGATOR_URL=http://host.docker.internal:10801
REGULATOR_URL=http://host.docker.internal:10808
ANALYTICS_URL=http://host.docker.internal:10990
KAFKA_BOOTSTRAP_SERVERS=host.docker.internal:19092
